*.jpeg    binary
*.gif     binary
*.bmp     binary
*.ico     binary
*.webp    binary
*.pdf     binary
*.zip     binary
*.7z      binary
*.rar     binary
*.gz      binary
*.tar     binary
*.xlsx    binary
*.xls     binary
*.docx    binary
*.doc     binary
*.pptx    binary

# ---------- 固件与可执行产物 ----------
*.hex     binary
*.bin     binary
*.elf     binary
*.axf     binary
*.s19     binary
*.srec    binary
*.o       binary
*.a       binary
*.lib     binary
*.so      binary
*.dll     binary
*.exe     binary
*.dylib   binary

# ---------- EDA 原生格式 ----------
# Altium 的 SchDoc/PcbDoc 为 OLE 复合文档，EasyEDA Pro 的 epro 为容器格式。
# KiCad 的 .kicad_sch / .kicad_pcb 是文本 S 表达式，交由上面的 text=auto
# 自动判定，以便保留可读、可 review 的 diff。
*.SchDoc  binary
*.PcbDoc  binary
*.PrjPcb  binary
*.epro    binary

# ---------- 机械 / 3D 模型 ----------
*.step    binary
*.stp     binary
*.stl     binary
*.igs     binary
*.iges    binary
*.f3d     binary
*.sldprt  binary
*.sldasm  binary
