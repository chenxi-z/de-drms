<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:local="clr-namespace:Drms.Gui"
        x:Class="Drms.Gui.MainWindow"
        x:DataType="local:MainViewModel"
        Title="DE-DRMS 双电极电阻测量仪"
        Width="1180" Height="900"
        Background="White"
        FontFamily="Microsoft YaHei UI, Noto Sans CJK SC, sans-serif">

    <!-- MATLAB 风格：白底、四边全框、浅灰网格、无圆角无阴影。 -->
    <Window.Styles>
        <Style Selector="TextBlock.readout">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#6B7280" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Styles>

    <!-- 布局注意：ScottPlot 的 AvaPlot 在 Avalonia 12 下用"列"布局时会无视列宽、
         铺满整行并把右侧控件完全遮住（已用最小工程复现）。用"行"布局则正常，
         因此图表与配置面板上下排，不用左右分栏。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12">

        <!-- ===== 连接栏 ===== -->
        <Border BorderBrush="#D1D5DB" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,180,Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="串口" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" x:Name="PortBox"
                          ItemsSource="{Binding Ports}"
                          SelectedItem="{Binding SelectedPort}"
                          Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="刷新" Click="OnRefreshPorts" />
                <Button Grid.Column="3" Content="连接" Click="OnConnect"
                        IsEnabled="{Binding CanConnect}" />
                <TextBlock Grid.Column="4" Text="{Binding ConnectionText}"
                           VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" />
                <TextBlock Grid.Column="5" Text="{Binding DeviceUid}"
                           VerticalAlignment="Center" Foreground="#6B7280" FontFamily="Consolas,monospace" />
            </Grid>
        </Border>

        <!-- ===== 读数面板 ===== -->
        <Border BorderBrush="#D1D5DB" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Width="150" Margin="0,0,8,0">
                    <TextBlock Classes="label" Text="R" />
                    <TextBlock Classes="readout" Text="{Binding OhmsText}" />
                </StackPanel>
                <StackPanel Width="115" Margin="0,0,8,0">
                    <TextBlock Classes="label" Text="R/R0" />
                    <TextBlock Classes="readout" Text="{Binding RatioText}" />
                </StackPanel>
                <StackPanel Width="80" Margin="0,0,8,0">
                    <TextBlock Classes="label" Text="等级" />
                    <TextBlock Classes="readout" Text="{Binding LevelText}" />
                </StackPanel>
                <StackPanel Width="140" Margin="0,0,8,0">
                    <TextBlock Classes="label" Text="分类状态" />
                    <TextBlock Classes="readout" FontSize="16" Text="{Binding ClassificationText}" />
                </StackPanel>
                <StackPanel Width="140" Margin="0,0,8,0">
                    <TextBlock Classes="label" Text="采集 / 记录" />
                    <TextBlock FontSize="15" Foreground="#111827">
                        <Run Text="{Binding AcquisitionText}" /><Run Text=" / " /><Run Text="{Binding RecordingText}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Width="160">
                    <TextBlock Classes="label" Text="介质 / 电池" />
                    <TextBlock FontSize="15" Foreground="#111827">
                        <Run Text="{Binding MediumText}" /><Run Text=" · " /><Run Text="{Binding BatteryText}" />
                    </TextBlock>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ===== 双图 =====
             AvaPlot 必须给固定 Height：它在 Avalonia 12 下不守星号尺寸，
             会铺满并盖住同级控件（左右分栏、DockPanel、Overlay、官方示例的
             Grid 单元格写法全部实测失败）。固定高度是唯一可靠的约束方式。 -->
        <Border BorderBrush="#D1D5DB" BorderThickness="1" Height="340" Margin="0,0,0,4">
            <sp:AvaPlot x:Name="RatioPlot" />
        </Border>
        <Border BorderBrush="#D1D5DB" BorderThickness="1" Height="240">
            <sp:AvaPlot x:Name="OhmsPlot" />
        </Border>

        <!-- ===== 4 kSPS 波形 + PC 落盘 =====
             RAW 流是"看波形"的窗口：设备每 60 帧（约 15 ms）推一批，
             界面按 100 ms 分桶画 min/max 包络与均值（曲线规格 §7.4：抽稀必须保尖峰）。
             落盘写的是与设备同构的 BIN v2 文件，按大小轮转，可直接用
             tools/de_drms_log.py 解码——但 USB 流可能丢批，设备 TF 记录才是权威。 -->
        <Border BorderBrush="#D1D5DB" BorderThickness="1" Padding="10" Margin="0,8,0,0">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="4 kSPS 波形" FontWeight="SemiBold"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox Grid.Column="1" Content="同时落盘到 PC" IsChecked="{Binding RawRecord}"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox Grid.Column="2" Text="{Binding RawDirectory}" MinHeight="26" FontSize="12"
                             PlaceholderText="落盘目录（相对当前工作目录）" />
                    <TextBlock Grid.Column="3" Text="轮转 MiB" VerticalAlignment="Center"
                               FontSize="12" Margin="10,0,6,0" />
                    <TextBox Grid.Column="4" Text="{Binding RawRotateText}" Width="70" MinHeight="26"
                             FontSize="12" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button Content="开启" Click="OnStartRaw" IsEnabled="{Binding CanStartRaw}" />
                        <Button Content="停止" Click="OnStopRaw" IsEnabled="{Binding CanStopRaw}" Margin="0" />
                    </StackPanel>
                </Grid>
                <TextBlock Classes="hint" Margin="0,4,0,0" Text="{Binding RawStatusText}" />
                <TextBlock Classes="hint" Margin="0,2,0,0"
                           Text="包络为 100 ms 桶内的 min/max（保尖峰），实线为桶均值；逐帧数据请用设备 TF 记录或 PC 落盘文件。" />
                <Border BorderBrush="#D1D5DB" BorderThickness="1" Height="200" Margin="0,6,0,0">
                    <sp:AvaPlot x:Name="RawPlot" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== 配置与基线（可折叠） ===== -->
        <Expander Header="配置与基线" IsExpanded="False" Margin="0,8,0,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Border BorderBrush="#D1D5DB" BorderThickness="1" Padding="10">
                <Grid ColumnDefinitions="*,Auto,*">

                    <!-- 左：等级区间 -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="等级区间" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Classes="hint" Margin="0,2,0,6"
                                   Text="上界按 R/R0 偏移百分比填；绿色下界自动取 -10%（容差），回差需小于区间宽度的一半。" />

                        <Grid ColumnDefinitions="44,*,*" Margin="0,0,0,3">
                            <TextBlock Grid.Column="0" Classes="label" Text="等级" />
                            <TextBlock Grid.Column="1" Classes="label" Text="上界 %" />
                            <TextBlock Grid.Column="2" Classes="label" Text="回差 %" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Config.Bands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:BandRow">
                                    <Grid ColumnDefinitions="44,*,*" Margin="0,0,0,3">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   VerticalAlignment="Center" FontSize="12" />
                                        <TextBox Grid.Column="1" Text="{Binding UpperPercent}"
                                                 Margin="0,0,5,0" MinHeight="26" FontSize="12" />
                                        <TextBox Grid.Column="2" Text="{Binding HysteresisPercent}"
                                                 MinHeight="26" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Config.ValidationText}" Classes="hint"
                                   Foreground="#B45309" Margin="0,4,0,6" />
                        <Button Content="下发配置" Click="OnApplyConfig"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <TextBlock Text="{Binding Config.ApplyResult}" Classes="hint" Margin="0,4,0,0" />
                    </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="#E5E7EB" Margin="0,0,16,0" />

                <!-- 右：建立基线 -->
                <StackPanel Grid.Column="2" MinWidth="330">
                    <TextBlock Text="建立基线 R0" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Classes="hint" Margin="0,2,0,6"
                               Text="设备连续采一段有效读数算均值。成功后采集会重启，曲线断开一次。" />

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="采样窗口" VerticalAlignment="Center" FontSize="12"
                                   Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Config.BaselineDurations}"
                                  SelectedItem="{Binding Config.SelectedDuration}"
                                  HorizontalAlignment="Stretch" FontSize="12" />
                        <Button Grid.Column="2" Content="开始" Click="OnBuildBaseline" Margin="8,0,4,0"
                                IsEnabled="{Binding Config.Baseline.CanStart}" />
                        <Button Grid.Column="3" Content="取消" Click="OnCancelBaseline" Margin="0"
                                IsEnabled="{Binding Config.Baseline.Running}" />
                    </Grid>

                    <ProgressBar Value="{Binding Config.Baseline.ProgressValue}" Height="6"
                                 Maximum="1" Margin="0,0,0,4" />

                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,1">
                        <TextBlock Grid.Column="0" Classes="hint" Text="进度 " />
                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Config.Baseline.ProgressText}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,1">
                        <TextBlock Grid.Column="0" Classes="hint" Text="均值 " />
                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Config.Baseline.MeanText}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,1">
                        <TextBlock Grid.Column="0" Classes="hint" Text="CV " />
                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Config.Baseline.CvText}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,1">
                        <TextBlock Grid.Column="0" Classes="hint" Text="稳定度 " />
                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Config.Baseline.StabilityText}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Classes="hint" Text="当前基线 " />
                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding R0StatusText}" />
                    </Grid>

                    <TextBlock Text="{Binding Config.Baseline.PreconditionText}" Classes="hint"
                               Foreground="#B91C1C" Margin="0,0,0,3" />
                    <TextBlock Text="{Binding Config.Baseline.Result}" Classes="hint" />
                </StackPanel>
                </Grid>
            </Border>
        </Expander>

        <!-- ===== 状态栏 ===== -->
        <Border BorderBrush="#D1D5DB" BorderThickness="1" Padding="8" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="#374151" FontSize="12" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#6B7280"
                           Margin="12,0,0,0" FontSize="12">
                    <Run Text="质量：" /><Run Text="{Binding QualityText}" />
                    <Run Text="  新鲜度：" /><Run Text="{Binding FreshText}" />
                </TextBlock>
                <Button Grid.Column="2" Content="断开" Click="OnDisconnect" Margin="12,0,0,0" />
            </Grid>
        </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
